# Configuration ESP-IDF pour augmenter les limites VFS
# Ce fichier est utilisé par ESPHome lors de la compilation avec framework: esp-idf

#
# CRITICAL: Compiler Performance Optimization (FOUND THE BOTTLENECK!)
#
# Espressif's esp_imgfx benchmarks use this flag
# WITHOUT IT: YUV→RGB is 5× slower (16-20ms vs 3-5ms expected)
# Benchmarks show 1920×1080 I420→RGB565 at 131.6 MB/s with this flag
# User's setup without it: only 24.8 MB/s (5.3× slower!)
CONFIG_COMPILER_OPTIMIZATION_PERF=y

#
# FreeRTOS / Memory Configuration
# CRITICAL: ESP32-P4 with video subsystem needs larger main task stack
# Default 3584 bytes is too small when ISP+JPEG+H264+CSI all register at startup
#
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
CONFIG_FREERTOS_TIMER_TASK_STACK_DEPTH=4096
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y

#
# PSRAM Cache Optimization
#
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_WRITEBACK=y
CONFIG_CACHE_L2_CACHE_256KB=y
CONFIG_CACHE_L2_CACHE_LINE_128B=y

# FATFS optimizations for sustained SD card read performance
CONFIG_FATFS_PER_FILE_CACHE=y
CONFIG_FATFS_SECTOR_4096=y
CONFIG_FATFS_VFS_FSTAT_BLKSIZE=4096

