# Configuration ESP-IDF pour augmenter les limites VFS
# Ce fichier est utilisé par ESPHome lors de la compilation avec framework: esp-idf

#
# PSRAM Cache Optimization (fix 16.5 MB/s → 40-50 MB/s bandwidth)
#
# Write-Back cache mode provides significantly better SPIRAM bandwidth
# than Write-Through mode by reducing memory bus contention during
# simultaneous READ+WRITE operations (YUV→RGB conversion)
CONFIG_SPIRAM_WRITEBACK=y

# L2 Cache optimization for SPIRAM access
CONFIG_CACHE_L2_CACHE_128KB=y
CONFIG_CACHE_L2_CACHE_LINE_128B=y

