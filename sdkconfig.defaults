# Augmenter la limite VFS pour supporter plus de devices video
# Par défaut: CONFIG_VFS_MAX_COUNT=8
# Nous avons besoin de:
# - 4 video devices (/dev/video0, /dev/video10, /dev/video11, /dev/video20)
# - Sockets réseau (lwip)
# - Autres VFS (UART, etc.)
#CONFIG_VFS_MAX_COUNT=16

# Augmenter aussi le nombre maximal de file descriptors
# Par défaut: CONFIG_LWIP_MAX_SOCKETS=10
#CONFIG_LWIP_MAX_SOCKETS=16

# ESP-Video ISP Pipeline Controller - CRITICAL for JSON IPA loading
# This enables the ISP pipeline initialization code in esp_video_init.c
# which loads and applies the JSON IPA configuration (AWB, CCM, sharpen, etc.)
CONFIG_ESP_VIDEO_ENABLE_ISP_PIPELINE_CONTROLLER=y

# OV02C10 Camera sensor - Enable default IPA JSON configuration
# This loads the ISP tuning parameters from ov02c10_default.json
CONFIG_CAMERA_OV02C10_DEFAULT_IPA_JSON_CONFIGURATION_FILE=y

# Enable ESP-DL human face detection
CONFIG_HUMAN_FACE_DETECT_MSR_S8_V1=y
CONFIG_HUMAN_FACE_DETECT_MNP_S8_V1=y
CONFIG_HUMAN_FACE_DETECT_MODEL_IN_FLASH_RODATA=y

# FATFS optimizations for sustained SD card video streaming performance
CONFIG_FATFS_PER_FILE_CACHE=y
CONFIG_FATFS_SECTOR_4096=y
CONFIG_FATFS_VFS_FSTAT_BLKSIZE=4096

# Enable ESP-DL pedestrian detection
CONFIG_PEDESTRIAN_DETECT_PICO_S8_V1=y
CONFIG_PEDESTRIAN_DETECT_MODEL_IN_FLASH_RODATA=y
